# ─────────────────────────────────────────────────────────────
#  Variables de entorno del monorepo (Vercel)
#
#  En Vercel NO se sube ningún .env: define estas variables en
#  Project → Settings → Environment Variables (Production + Preview).
#  Para desarrollo local, cópialas a backend/.env (ver backend/.env.example).
# ─────────────────────────────────────────────────────────────

# ── Azure Speech (OBLIGATORIO) ───────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Idioma por defecto (variante regional de español): es-CL, es-MX, es-ES…
DEFAULT_LANGUAGE=es-CL

# Tamaño máximo del audio, en MB.
# ⚠️ En Vercel el cuerpo de una Serverless Function no puede pasar de ~4.5 MB.
#    Un párrafo de 40–70 palabras (~20–40 s) pesa <1.5 MB, así que 4 va sobrado.
MAX_AUDIO_MB=4

# ── Claude / Anthropic (OPCIONAL) ────────────────────────────
# Si la defines, el feedback lo redacta Claude. Si no, se usa un feedback por reglas.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── CORS (OPCIONAL) ──────────────────────────────────────────
# Frontend y API comparten dominio en Vercel, así que normalmente NO hace falta.
# Solo si sirves el frontend desde otro dominio, pon aquí su URL exacta.
CORS_ORIGIN=
