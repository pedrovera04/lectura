# ─────────────────────────────────────────────────────────────
#  Backend – variables de entorno
#  Copia este archivo a ".env" y completa los valores.
#  NUNCA subas el archivo .env real al repositorio.
# ─────────────────────────────────────────────────────────────

# Puerto del servidor Express
PORT=3001

# Origen permitido para CORS (URL del frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173

# ── Azure Speech (OBLIGATORIO) ───────────────────────────────
# Clave y región del recurso "Speech" en el portal de Azure.
# La región es el identificador corto, por ejemplo: eastus, westus, brazilsouth.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Idioma por defecto para la evaluación (variante regional de español).
# Ejemplos: es-CL (Chile), es-MX (México), es-ES (España).
DEFAULT_LANGUAGE=es-CL

# Tamaño máximo del audio recibido, en megabytes.
MAX_AUDIO_MB=10

# ── Claude / Anthropic (OPCIONAL) ────────────────────────────
# Si defines la clave, el backend usará Claude para redactar el
# feedback educativo. Si la dejas vacía, se usa un feedback
# generado con reglas simples (la app funciona igual de extremo a extremo).
ANTHROPIC_API_KEY=
# Modelo de Claude a utilizar. Un modelo rápido y económico basta para esta tarea.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
