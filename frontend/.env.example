# ─────────────────────────────────────────────────────────────
#  Frontend – variables de entorno (Vite)
#  Copia este archivo a ".env" si necesitas cambiar los valores.
# ─────────────────────────────────────────────────────────────

# URL base de la API.
# - En desarrollo puedes dejarlo vacío o en "/api": Vite hace de proxy
#   hacia el backend (ver vite.config.ts).
# - En producción (Vercel) apunta a la URL pública de tu backend,
#   por ejemplo: https://mi-backend.up.railway.app/api
VITE_API_BASE_URL=/api
